# Long random JWT signing secret (use a managed secret in production) (required)
SESSION_SECRET=''

# Expected JWT issuer (required)
JWT_ISSUER=http://localhost:3000

# Expected JWT audience (required)
JWT_AUDIENCE=web

# Allowed browser client origin
FRONTEND_URL=http://localhost:5173

# Frontend API base URL
VITE_API_URL=http://localhost:3000/api/v1

# Set true in Cloud Run to load this dotenv-formatted secret with Application
# Default Credentials. The Docker image sets this automatically.
ENV_MODE=false
SECRET_MANAGER_SECRET=projects/933874694474/locations/us-east4/secrets/nodistractions-secrets

# Neon pooled PostgreSQL connection string for the running API (required).
# Its hostname contains "-pooler".
DATABASE_URL=''

# Neon direct PostgreSQL connection string for `go run ./cmd/migrate` (required).
# Its hostname does not contain "-pooler".
DATABASE_URL_UNPOOLED=''

# Google Cloud project ID (required)
GCP_PROJECT_ID=''

# Cloud Storage bucket (required)
GCP_STORAGE_BUCKET=''

# Twilio Account SID for the Twilio Email API (required)
TWILIO_ACCOUNT_SID=''

# Twilio Auth Token for the Twilio Email API (required)
TWILIO_AUTH_TOKEN=''

# Authorized Twilio Email sender address (required)
TWILIO_EMAIL_FROM='no-reply@nodistractions.online'

# Display name for the Twilio Email sender (required)
TWILIO_EMAIL_FROM_NAME='No Distractions'
